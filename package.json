{
  "name": "resolutioncascade",
  "version": "1.0.0",
  "description": "Desktop app with Electron",
  "main": "main.js",
  "scripts": {
  "start": "electron .",
  "dist": "electron-builder",
  "dist:win": "electron-builder --win nsis portable --publish=never"
  },

  "build": {
    "appId": "com.example.resolutioncascade",
    "productName": "ResolutionCascade",

    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"        
    },

    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "config.html",
      "assets/**",
      "build/**",
      "package.json",
      "!dist{,/**}",
      "!venv{,/**}",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!.git{,/**}",
      "!.vscode{,/**}"
    ],

    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },

    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  },

  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12"
  }
}
